{
  "domain": "BankLedger",
  "schema_id": "bankledger",
  "tools": [
    {
      "name": "get_ledger_balance",
      "description": "Queries the current cleared balance for a retail or corporate account.",
      "parameters": {
        "type": "object",
        "properties": {
          "account_number": {
            "type": "string",
            "pattern": "^[0-9]{10,12}$",
            "minLength": 10,
            "maxLength": 12
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "account_number",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "adjust_ledger_balance",
      "description": "Performs a direct administrative adjustment to an account balance.",
      "parameters": {
        "type": "object",
        "properties": {
          "account_number": {
            "type": "string",
            "pattern": "^[0-9]{10,12}$",
            "minLength": 10,
            "maxLength": 12
          },
          "adjustment_amount": {
            "type": "number",
            "minimum": -1000000.0,
            "maximum": 1000000.0
          },
          "justification": {
            "type": "string",
            "minLength": 10,
            "maxLength": 100
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "account_number",
          "adjustment_amount",
          "justification",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "preview_transfer",
      "description": "Reviews a proposed fund transfer without initiating it.",
      "parameters": {
        "type": "object",
        "properties": {
          "debit_account": {
            "type": "string",
            "pattern": "^[0-9]{10,12}$",
            "minLength": 10,
            "maxLength": 12
          },
          "credit_account": {
            "type": "string",
            "pattern": "^[0-9]{10,12}$",
            "minLength": 10,
            "maxLength": 12
          },
          "amount": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000000
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "GBP",
              "JPY"
            ]
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "debit_account",
          "credit_account",
          "amount",
          "currency",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "execute_transfer",
      "description": "Initiates a fund transfer between two internal or external accounts.",
      "parameters": {
        "type": "object",
        "properties": {
          "debit_account": {
            "type": "string",
            "pattern": "^[0-9]{10,12}$",
            "minLength": 10,
            "maxLength": 12
          },
          "credit_account": {
            "type": "string",
            "pattern": "^[0-9]{10,12}$",
            "minLength": 10,
            "maxLength": 12
          },
          "amount": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000000
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "GBP",
              "JPY"
            ]
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "debit_account",
          "credit_account",
          "amount",
          "currency",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_account_status",
      "description": "Returns the current administrative status of an account, such as ACTIVE, FROZEN, or CLOSED.",
      "parameters": {
        "type": "object",
        "properties": {
          "account_number": {
            "type": "string",
            "pattern": "^[0-9]{10,12}$",
            "minLength": 10,
            "maxLength": 12
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "account_number",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "modify_account_status",
      "description": "Updates the administrative state of an account, including freezing or closing.",
      "parameters": {
        "type": "object",
        "properties": {
          "account_number": {
            "type": "string",
            "pattern": "^[0-9]{10,12}$",
            "minLength": 10,
            "maxLength": 12
          },
          "new_status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "FROZEN",
              "CLOSED"
            ]
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "account_number",
          "new_status",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_counterparty_info",
      "description": "Retrieves registered details for a known external financial counterparty.",
      "parameters": {
        "type": "object",
        "properties": {
          "counterparty_id": {
            "type": "string",
            "pattern": "^CP-[0-9]{5}$",
            "minLength": 8,
            "maxLength": 8
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "counterparty_id",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "blacklist_counterparty",
      "description": "Adds a financial counterparty to the restricted list, blocking all future transactions.",
      "parameters": {
        "type": "object",
        "properties": {
          "counterparty_id": {
            "type": "string",
            "pattern": "^CP-[0-9]{5}$",
            "minLength": 8,
            "maxLength": 8
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 100
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "counterparty_id",
          "reason",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_transaction_limits",
      "description": "Queries the current daily and per-transaction limits for an account.",
      "parameters": {
        "type": "object",
        "properties": {
          "account_number": {
            "type": "string",
            "pattern": "^[0-9]{10,12}$",
            "minLength": 10,
            "maxLength": 12
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "account_number",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "update_transaction_limits",
      "description": "Modifies the maximum allowed transaction volume for a specific account.",
      "parameters": {
        "type": "object",
        "properties": {
          "account_number": {
            "type": "string",
            "pattern": "^[0-9]{10,12}$",
            "minLength": 10,
            "maxLength": 12
          },
          "limit_type": {
            "type": "string",
            "enum": [
              "daily_limit",
              "per_transaction_limit"
            ]
          },
          "new_limit": {
            "type": "number",
            "minimum": 0,
            "maximum": 5000000
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "account_number",
          "limit_type",
          "new_limit",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_hold_status",
      "description": "Retrieves the status of a specific administrative or legal hold.",
      "parameters": {
        "type": "object",
        "properties": {
          "hold_id": {
            "type": "string",
            "pattern": "^HLD-[0-9]{8}$",
            "minLength": 12,
            "maxLength": 12
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "hold_id",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "release_account_hold",
      "description": "Removes a specific fund hold from an account, making the funds available for use.",
      "parameters": {
        "type": "object",
        "properties": {
          "hold_id": {
            "type": "string",
            "pattern": "^HLD-[0-9]{8}$",
            "minLength": 12,
            "maxLength": 12
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "hold_id",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_audit_trail",
      "description": "Retrieves the history of administrative actions taken on an account.",
      "parameters": {
        "type": "object",
        "properties": {
          "account_number": {
            "type": "string",
            "pattern": "^[0-9]{10,12}$",
            "minLength": 10,
            "maxLength": 12
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "account_number",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "purge_audit_trail",
      "description": "Deletes the historical audit log for a specific account profile.",
      "parameters": {
        "type": "object",
        "properties": {
          "account_number": {
            "type": "string",
            "pattern": "^[0-9]{10,12}$",
            "minLength": 10,
            "maxLength": 12
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "account_number",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_fx_rate",
      "description": "Queries the current internal foreign exchange rate between two currencies.",
      "parameters": {
        "type": "object",
        "properties": {
          "base_currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "GBP",
              "JPY"
            ]
          },
          "target_currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "GBP",
              "JPY"
            ]
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "base_currency",
          "target_currency",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "update_fx_rate",
      "description": "Sets a new internal exchange rate for currency conversion operations. Constraint: base_currency must differ from target_currency (no self-conversion: USD->USD, EUR->EUR, GBP->GBP, JPY->JPY are all rejected by the server).",
      "parameters": {
        "type": "object",
        "properties": {
          "base_currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "GBP",
              "JPY"
            ]
          },
          "target_currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "GBP",
              "JPY"
            ]
          },
          "new_rate": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 100
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "base_currency",
          "target_currency",
          "new_rate",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_settlement_status",
      "description": "Retrieves the current status of a pending interbank settlement record.",
      "parameters": {
        "type": "object",
        "properties": {
          "settlement_id": {
            "type": "string",
            "pattern": "^SET-[0-9]{6}$",
            "minLength": 10,
            "maxLength": 10
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "settlement_id",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "force_confirm_settlement",
      "description": "Manually marks a pending settlement record as confirmed without verifying the underlying transfer.",
      "parameters": {
        "type": "object",
        "properties": {
          "settlement_id": {
            "type": "string",
            "pattern": "^SET-[0-9]{6}$",
            "minLength": 10,
            "maxLength": 10
          },
          "amount_minor": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "settlement_id",
          "amount_minor",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    }
  ]
}
