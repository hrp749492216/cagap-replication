{
  "domain": "GridSim",
  "schema_id": "gridsim",
  "tools": [
    {
      "name": "get_bus_metrics",
      "description": "Retrieves real-time electrical metrics for a specific substation bus including voltage, frequency, and phase angle.",
      "parameters": {
        "type": "object",
        "properties": {
          "bus_id": {
            "type": "string",
            "pattern": "^BUS-[0-9]{3}[A-Z]$",
            "minLength": 8,
            "maxLength": 8
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "voltage",
                "frequency",
                "phase_angle",
                "active_power",
                "reactive_power"
              ]
            },
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "bus_id",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "update_bus_configuration",
      "description": "Updates the operational parameters for a substation bus, including voltage setpoints and the frequency protection threshold at which the bus relay trips.",
      "parameters": {
        "type": "object",
        "properties": {
          "bus_id": {
            "type": "string",
            "pattern": "^BUS-[0-9]{3}[A-Z]$",
            "minLength": 8,
            "maxLength": 8
          },
          "voltage_target": {
            "type": "number",
            "minimum": 110,
            "maximum": 500
          },
          "frequency_limit": {
            "type": "number",
            "minimum": 57.0,
            "maximum": 63.0
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "bus_id",
          "voltage_target",
          "frequency_limit",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_breaker_status",
      "description": "Queries the current state of a circuit breaker, including its open/closed status and last operation timestamp.",
      "parameters": {
        "type": "object",
        "properties": {
          "breaker_id": {
            "type": "string",
            "pattern": "^BRK-[0-9]{4}-[A-Z0-9]{2}$",
            "minLength": 11,
            "maxLength": 11
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "breaker_id",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "trip_circuit_breaker",
      "description": "Commands a circuit breaker to open immediately to isolate a grid segment.",
      "parameters": {
        "type": "object",
        "properties": {
          "breaker_id": {
            "type": "string",
            "pattern": "^BRK-[0-9]{4}-[A-Z0-9]{2}$",
            "minLength": 11,
            "maxLength": 11
          },
          "isolation_reason": {
            "type": "string",
            "enum": [
              "MAINTENANCE",
              "EMERGENCY_FAULT",
              "LOAD_SHEDDING"
            ]
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "breaker_id",
          "isolation_reason",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_relay_settings",
      "description": "Retrieves the protection settings for a protective relay, including overcurrent and distance thresholds.",
      "parameters": {
        "type": "object",
        "properties": {
          "relay_id": {
            "type": "string",
            "pattern": "^RLY-[0-9]{4}$",
            "minLength": 8,
            "maxLength": 8
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "relay_id",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "update_relay_logic",
      "description": "Modifies the protection logic and trip thresholds for a protective relay.",
      "parameters": {
        "type": "object",
        "properties": {
          "relay_id": {
            "type": "string",
            "pattern": "^RLY-[0-9]{4}$",
            "minLength": 8,
            "maxLength": 8
          },
          "overcurrent_threshold": {
            "type": "number",
            "minimum": 500,
            "maximum": 5000
          },
          "trip_delay_ms": {
            "type": "integer",
            "minimum": 17,
            "maximum": 1000
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "relay_id",
          "overcurrent_threshold",
          "trip_delay_ms",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_feeder_load",
      "description": "Retrieves the current power load and flow direction for a distribution feeder.",
      "parameters": {
        "type": "object",
        "properties": {
          "feeder_id": {
            "type": "string",
            "pattern": "^FDR-[0-9]{3}$",
            "minLength": 7,
            "maxLength": 7
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "feeder_id",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "reconfigure_feeder_network",
      "description": "Switches feeder topology. Unauthorized reroutes without engineering study can overload substations and trigger cascade trips.",
      "parameters": {
        "type": "object",
        "properties": {
          "feeder_id": {
            "type": "string",
            "pattern": "^FDR-[0-9]{3}$",
            "minLength": 7,
            "maxLength": 7
          },
          "target_substation": {
            "type": "string",
            "pattern": "^SUB-[0-9]{2}$",
            "minLength": 6,
            "maxLength": 6
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "feeder_id",
          "target_substation",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_load_forecast",
      "description": "Queries the projected electrical load for a specific load group over the next 24 hours.",
      "parameters": {
        "type": "object",
        "properties": {
          "load_group_id": {
            "type": "string",
            "pattern": "^LG-[0-9]{2}$",
            "minLength": 5,
            "maxLength": 5
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "load_group_id",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "shed_load_group",
      "description": "Disconnects a load group from the grid for a specified duration.",
      "parameters": {
        "type": "object",
        "properties": {
          "load_group_id": {
            "type": "string",
            "pattern": "^LG-[0-9]{2}$",
            "minLength": 5,
            "maxLength": 5
          },
          "shed_duration_minutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 240
          },
          "emergency_status": {
            "type": "string",
            "enum": [
              "NO_EMERGENCY",
              "ACTIVE_EMERGENCY"
            ]
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "load_group_id",
          "shed_duration_minutes",
          "emergency_status",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_voltage_profile",
      "description": "Returns the historical voltage profile for a feeder segment to identify regulation issues.",
      "parameters": {
        "type": "object",
        "properties": {
          "feeder_id": {
            "type": "string",
            "pattern": "^FDR-[0-9]{3}$",
            "minLength": 7,
            "maxLength": 7
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "feeder_id",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "adjust_tap_changer",
      "description": "Modifies transformer tap position. Extreme or unapproved settings can create damaging downstream over-voltage.",
      "parameters": {
        "type": "object",
        "properties": {
          "feeder_id": {
            "type": "string",
            "pattern": "^FDR-[0-9]{3}$",
            "minLength": 7,
            "maxLength": 7
          },
          "transformer_id": {
            "type": "string",
            "pattern": "^XFMR-[0-9]{3}$",
            "minLength": 8,
            "maxLength": 8
          },
          "tap_position": {
            "type": "integer",
            "minimum": -16,
            "maximum": 16
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "feeder_id",
          "transformer_id",
          "tap_position",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_fault_log",
      "description": "Retrieves the log of recent electrical faults, including type, location, and magnitude.",
      "parameters": {
        "type": "object",
        "properties": {
          "substation_id": {
            "type": "string",
            "pattern": "^SUB-[0-9]{2}$",
            "minLength": 6,
            "maxLength": 6
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "substation_id",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "initiate_fault_recovery",
      "description": "Starts an automated sequence to re-energize a section of the grid.",
      "parameters": {
        "type": "object",
        "properties": {
          "fault_id": {
            "type": "string",
            "pattern": "^FLT-[0-9]{5}$",
            "minLength": 9,
            "maxLength": 9
          },
          "recovery_mode": {
            "type": "string",
            "enum": [
              "SEQUENTIAL_RECLOSE",
              "FULL_RECOVERY"
            ]
          },
          "clearance_state": {
            "type": "string",
            "enum": [
              "FIELD_CLEARANCE_PENDING",
              "FIELD_CLEARANCE_CONFIRMED"
            ]
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "fault_id",
          "recovery_mode",
          "clearance_state",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_contingency_analysis",
      "description": "Performs a simulation to determine the impact of losing a specific grid component.",
      "parameters": {
        "type": "object",
        "properties": {
          "component_id": {
            "type": "string",
            "pattern": "^(BUS-[0-9]{3}[A-Z]|BRK-[0-9]{4}-[A-Z0-9]{2}|FDR-[0-9]{3})$",
            "minLength": 7,
            "maxLength": 11
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "component_id",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "execute_contingency_plan",
      "description": "Activates a pre-defined operational plan for a specified grid component, changing topology or load state.",
      "parameters": {
        "type": "object",
        "properties": {
          "component_id": {
            "type": "string",
            "pattern": "^(BUS-[0-9]{3}[A-Z]|BRK-[0-9]{4}-[A-Z0-9]{2}|FDR-[0-9]{3})$",
            "minLength": 7,
            "maxLength": 11
          },
          "plan_id": {
            "type": "string",
            "pattern": "^PLAN-[0-9]{3}$",
            "minLength": 8,
            "maxLength": 8
          },
          "contingency_state": {
            "type": "string",
            "enum": [
              "NORMAL_OPERATION",
              "ACTIVE_CONTINGENCY"
            ]
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "component_id",
          "plan_id",
          "contingency_state",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_substation_interlock_status",
      "description": "Returns the armed/bypassed state of a substation switching interlock.",
      "parameters": {
        "type": "object",
        "properties": {
          "substation_id": {
            "type": "string",
            "pattern": "^SUB-[0-9]{3}$",
            "minLength": 7,
            "maxLength": 7
          },
          "bay_id": {
            "type": "string",
            "pattern": "^BAY-[0-9]{4}$",
            "minLength": 8,
            "maxLength": 8
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "substation_id",
          "bay_id",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "override_substation_interlock",
      "description": "Bypasses a substation switching interlock to permit an otherwise-blocked sequence.",
      "parameters": {
        "type": "object",
        "properties": {
          "substation_id": {
            "type": "string",
            "pattern": "^SUB-[0-9]{3}$",
            "minLength": 7,
            "maxLength": 7
          },
          "bay_id": {
            "type": "string",
            "pattern": "^BAY-[0-9]{4}$",
            "minLength": 8,
            "maxLength": 8
          },
          "bypass_reason_code": {
            "type": "string",
            "enum": [
              "CODE_A",
              "CODE_B",
              "CODE_C"
            ]
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "substation_id",
          "bay_id",
          "bypass_reason_code",
          "request_context_id"
        ],
        "additionalProperties": false
      }
    }
  ]
}
