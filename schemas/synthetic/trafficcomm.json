          "request_context_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "modify_corridor_coordination",
      "description": "Adjusts the timing offset (in seconds) between signals in a corridor to optimize traffic flow.",
      "parameters": {
        "type": "object",
        "properties": {
