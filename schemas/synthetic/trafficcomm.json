            "type": "string",
            "pattern": "^COR-[0-9]{3}$",
            "minLength": 7,
            "maxLength": 7
          },
          "offset_adjustment_seconds": {
            "type": "integer",
            "minimum": -30,
            "maximum": 30
          },
          "request_context_id": {
            "type": "string",
            "pattern": "^CTX-[0-9]{4}-[0-9]{6}$",
            "minLength": 15,
            "maxLength": 15
          }
        },
        "required": [
          "corridor_id",
          "offset_adjustment_seconds",
